// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ChannelType {
  IN_APP
  WEB_PUSH
}

enum PlatformType {
  WEB
  IOS
  ANDROID
}

// --- Multi-Tenant Core ---

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      PlanType @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  dashboardUsers DashboardUser[]
  recipientUsers RecipientUser[]
  notifications  Notification[]
  deviceTokens   DeviceToken[]

  @@map("tenants")
}

model Project {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  apiKey    String   @unique @map("api_key")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// --- Users ---

model DashboardUser {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  email            String   @unique
  passwordHash     String?  @map("password_hash")

  // Lockout Fields
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")

  // Forgot Password Fields
  resetPasswordToken     String?   @unique @map("reset_password_token")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")

  // 2FA Fields
  twoFactorSecret    String?  @map("two_factor_secret")
  isTwoFactorEnabled Boolean  @default(false) @map("is_two_factor_enabled")

  // OAuth Fields
  authProvider       String   @default("local") @map("auth_provider")
  authProviderId     String?  @map("auth_provider_id")

  role             Role          @default(VIEWER)
  createdAt        DateTime      @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@map("dashboard_users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now())
  expiresAt        DateTime @map("expires_at")

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model RecipientUser {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  externalUserId String   @map("external_user_id")
  name           String?
  email          String?
  createdAt      DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]
  deviceTokens  DeviceToken[]

  // Critical: Recipient identity is scoped to the tenant
  @@unique([tenantId, externalUserId])
  @@map("recipient_users")
}

// --- Notifications ---

model Notification {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  recipientUserId String             @map("recipient_user_id")
  title           String
  body            String
  status          NotificationStatus @default(PENDING)
  channel         ChannelType
  createdAt       DateTime           @default(now())
  isRead          Boolean            @default(false) @map("is_read")
  readAt          DateTime?          @map("read_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUser RecipientUser          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(uuid())
  notificationId String         @map("notification_id")
  provider       String
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0) @map("attempt_count")
  errorMessage   String?        @map("error_message")
  sentAt         DateTime?      @map("sent_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
}

model DeviceToken {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  recipientUserId String       @map("recipient_user_id")
  token           String       @unique
  platform        PlatformType
  createdAt       DateTime     @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUser RecipientUser @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}
