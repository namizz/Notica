// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  SIMULATED
}

enum ChannelType {
  IN_APP
  WEB_PUSH
  EMAIL
  SMS
}

// Lifecycle of one SMS between Notica and an Android gateway phone. States
// only move forward; FAILED is final.
enum SmsStatus {
  QUEUED
  DISPATCHED
  ACCEPTED
  SENT
  DELIVERED
  FAILED
}

enum SmsEncoding {
  GSM7
  UCS2
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlatformType {
  WEB
  IOS
  ANDROID
}

// --- Multi-Tenant Core ---

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      PlanType @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  dashboardUsers DashboardUser[]
  recipientUsers RecipientUser[]
  notifications  Notification[]
  deviceTokens   DeviceToken[]

  @@map("tenants")
}

model Project {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  apiKeyHash   String   @unique @map("api_key_hash")
  apiKeyPrefix String   @map("api_key_prefix")
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUsers RecipientUser[]
  notifications Notification[]
  deviceTokens DeviceToken[]
  gatewayDevices GatewayDevice[]
  webhookEndpoints WebhookEndpoint[]

  @@map("projects")
}

// --- Users ---

model DashboardUser {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  email            String   @unique
  passwordHash     String?  @map("password_hash")

  // Lockout Fields
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")

  // Forgot Password Fields
  resetPasswordToken     String?   @unique @map("reset_password_token")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")

  // 2FA Fields
  twoFactorSecret    String?  @map("two_factor_secret")
  isTwoFactorEnabled Boolean  @default(false) @map("is_two_factor_enabled")

  // OAuth Fields
  authProvider       String   @default("local") @map("auth_provider")
  authProviderId     String?  @map("auth_provider_id")

  role             Role          @default(VIEWER)
  createdAt        DateTime      @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@map("dashboard_users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now())
  expiresAt        DateTime @map("expires_at")

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model RecipientUser {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  projectId      String   @map("project_id")
  externalUserId String   @map("external_user_id")
  name           String?
  email          String?
  // E.164, e.g. +251911234567
  phone          String?  @db.VarChar(16)
  // Set after a hard bounce or spam complaint; email is no longer sent.
  emailSuppressedAt      DateTime? @map("email_suppressed_at")
  emailSuppressionReason String?   @map("email_suppression_reason")
  createdAt      DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications Notification[]
  deviceTokens  DeviceToken[]

  // Recipient identity is isolated per project.
  @@unique([projectId, externalUserId])
  @@index([tenantId])
  @@index([projectId])
  @@map("recipient_users")
}

// --- Notifications ---

model Notification {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  projectId       String             @map("project_id")
  recipientUserId String             @map("recipient_user_id")
  title           String
  body            String
  status          NotificationStatus @default(PENDING)
  channel         ChannelType
  createdAt       DateTime           @default(now())
  isRead          Boolean            @default(false) @map("is_read")
  readAt          DateTime?          @map("read_at")
  idempotencyKey  String?            @map("idempotency_key")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientUser RecipientUser          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@unique([projectId, idempotencyKey])
  @@index([tenantId])
  @@index([projectId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(uuid())
  notificationId String         @map("notification_id")
  provider       String
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0) @map("attempt_count")
  errorMessage   String?        @map("error_message")
  sentAt         DateTime?      @map("sent_at")
  // Id the provider returned (email API message id), used to match webhooks.
  providerMessageId String?     @map("provider_message_id")
  deliveredAt    DateTime?      @map("delivered_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  sms          SmsMessage?

  @@index([notificationId])
  @@index([providerMessageId])
  @@map("notification_deliveries")
}

// --- SMS gateway ---

// An Android phone running the Notica Gateway app, paired to one project.
model GatewayDevice {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  projectId        String    @map("project_id")
  name             String
  // sha256 of the long-lived device token; null until paired.
  tokenHash        String?   @unique @map("token_hash")
  // sha256 of the one-time pairing code shown as a QR code.
  pairingCodeHash  String?   @unique @map("pairing_code_hash")
  pairingExpiresAt DateTime? @map("pairing_expires_at")
  pairedAt         DateTime? @map("paired_at")
  model            String?
  androidSdk       Int?      @map("android_sdk")
  appVersion       String?   @map("app_version")
  // [{ slot, subscriptionId, carrier }]
  sims             Json?
  defaultSimSlot   Int?      @map("default_sim_slot")
  enabled          Boolean   @default(true)
  lastSeenAt       DateTime? @map("last_seen_at")
  lastHeartbeat    Json?     @map("last_heartbeat")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages SmsMessage[]

  @@index([projectId])
  @@map("gateway_devices")
}

// The SMS outbox. One row per SMS notification delivery; its id is the
// messageId on the wire between Notica and the phone.
model SmsMessage {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  projectId        String      @map("project_id")
  notificationId   String      @map("notification_id")
  deliveryId       String      @unique @map("delivery_id")
  gatewayDeviceId  String?     @map("gateway_device_id")
  to               String      @db.VarChar(16)
  // Nulled after the retention period.
  text             String?
  encoding         SmsEncoding
  parts            Int
  simSlot          Int?        @map("sim_slot")
  status           SmsStatus   @default(QUEUED)
  dispatchAttempts Int         @default(0) @map("dispatch_attempts")
  leaseUntil       DateTime?   @map("lease_until")
  expiresAt        DateTime    @map("expires_at")
  acceptedAt       DateTime?   @map("accepted_at")
  sentAt           DateTime?   @map("sent_at")
  deliveredAt      DateTime?   @map("delivered_at")
  failedAt         DateTime?   @map("failed_at")
  errorCode        String?     @map("error_code")
  errorMessage     String?     @map("error_message")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  device   GatewayDevice?       @relation(fields: [gatewayDeviceId], references: [id], onDelete: SetNull)

  @@index([gatewayDeviceId, status])
  @@index([status, leaseUntil])
  @@index([status, expiresAt])
  @@index([projectId, createdAt])
  @@index([notificationId])
  @@map("sms_messages")
}

// Status events received from gateway phones. The primary key is the phone's
// eventId, so a retried webhook is recognised and skipped.
model GatewayEvent {
  id         String   @id
  deviceId   String   @map("device_id")
  messageId  String   @map("message_id")
  type       String
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("gateway_events")
}

// --- Customer webhooks ---

model WebhookEndpoint {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  projectId   String   @map("project_id")
  url         String
  description String?
  // Event types this endpoint receives, e.g. notification.delivered.
  events      String[]
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  endpointId     String                @map("endpoint_id")
  eventId        String                @map("event_id")
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

model DeviceToken {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  projectId       String       @map("project_id")
  recipientUserId String       @map("recipient_user_id")
  token           String       @unique
  platform        PlatformType
  createdAt       DateTime     @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientUser RecipientUser @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@map("device_tokens")
}
