# Runtime
NODE_ENV="development"
PORT="8000"

# Deployment role for this process. One build artifact, three roles:
#   all    (default) serves HTTP and consumes the delivery queue
#   api    serves HTTP only; delivery is left to the worker role
#   worker consumes the delivery queue; HTTP stays up for health checks
# Leave unset for local development and single-service deployments.
APP_ROLE="all"

# Database and queue
DATABASE_URL="postgresql://user:password@localhost:5432/notica_dev?schema=public"
REDIS_URL="redis://localhost:6379"
# REDIS_HOST and REDIS_PORT remain supported when REDIS_URL is not provided.
# REDIS_HOST="localhost"
# REDIS_PORT="6379"

# Authentication & JWT Security
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-here"
# Used to sign short-lived, recipient-scoped browser SDK tokens.
# Use a different strong random value in production.
CLIENT_TOKEN_SECRET="your-super-secret-client-token-key-here"
# Public frontend origin used for CORS and browser redirects. Do not include a path.
FRONTEND_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/callback"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:8000/auth/github/callback"

# Web Push VAPID Keys
# Generate new VAPID keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:dev@yourdomain.com"

# Email Configuration
# EMAIL_PROVIDER selects the active provider: resend | smtp | console | off
# When unset: uses smtp if SMTP_HOST is set, else console in dev and off in production.
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@yourdomain.com"

# SMTP Settings (when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="your-email@yourdomain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@yourdomain.com"
# SMTP_SECURE="false" # defaults to true for port 465, false otherwise

# Resend API Settings (when EMAIL_PROVIDER="resend")
RESEND_API_KEY="re_your_api_key_here"
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_secret_here"

# SMS Gateway Configuration
# SMS_PROVIDER selects the active provider: gateway | console | off
# Unset means off. In dev, "console" simulates SMS sends.
SMS_PROVIDER="console"
# Secret key used to derive per-device signing secrets (min 32 chars).
GATEWAY_SIGNING_KEY="your-gateway-signing-secret-key-at-least-32-chars"
# Public base URL of this API embedded in pairing QR codes (must be https in prod)
PUBLIC_API_URL="http://localhost:8000"

# SMS Tunables (optional defaults shown)
# SMS_MESSAGE_TTL_MINUTES="60"
# SMS_MAX_PARTS="10"
# SMS_DAILY_LIMIT_PER_PROJECT="500"
# SMS_LEASE_SECONDS="120"
# SMS_MAX_DISPATCH_ATTEMPTS="5"
# SMS_REASSIGN_AFTER_SECONDS="300"
# SMS_TEXT_RETENTION_DAYS="30"

# Customer Webhook Signing Key (min 32 chars)
WEBHOOK_SIGNING_KEY="your-webhook-signing-secret-key-at-least-32-chars"
